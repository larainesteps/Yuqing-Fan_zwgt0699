{
  "name": "surgical-scheduler-demo",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "db:import-real": "node database/import-real-data.mjs",
    "db:optimize-real": "node database/optimize-real-data.mjs",
    "db:detect-conflicts": "node database/detect-conflicts.mjs",
    "db:modules": "node database/apply-module-schema.mjs",
    "experiment:run": "node database/run-algorithm-experiments.mjs",
    "experiment:ablation": "node database/run-algorithm-experiments.mjs --ablation",
    "experiment:export": "node database/export-experiment-results.mjs",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
